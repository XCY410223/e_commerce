# 复制为 .env 后按本机实际值修改：cp .env.example .env
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# 使用 ngrok/Cloudflare Tunnel 等公网 HTTPS 地址时：
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,xxxx.trycloudflare.com
# CSRF_TRUSTED_ORIGINS=https://xxxx.trycloudflare.com
# TRUST_X_FORWARDED_PROTO=1

# 数据库：mysql | sqlite（未装 MySQL 时改成 sqlite 即可跑通）
DB_ENGINE=mysql
DB_NAME=e_commerce
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

REDIS_URL=redis://127.0.0.1:6379/0

# 购物车滑动有效期（秒），默认 30 天；设为 0 表示不过期
CART_TTL=2592000
# 游客购物车有效期（秒），默认 7 天
GUEST_CART_TTL=604800

# 首页/分类列表公共内容 Redis 片段缓存时长（秒），设为 0 可关闭
GOODS_INDEX_CACHE_TTL=60
GOODS_LIST_CACHE_TTL=60
GOODS_NAV_CACHE_TTL=300

# 页面静态化：Celery 生成首页与分类列表；匿名且无游客购物车 Cookie 时优先读取
STATIC_PAGES_ENABLED=1
# 开发期默认关闭自动刷新，正式环境建议开启；数据变更后异步重建静态页
STATIC_PAGES_AUTO_REFRESH=0
# 留空时使用项目根目录下的 static_pages/
STATIC_PAGES_ROOT=
# Celery beat 定时重建间隔（秒），设为 0 表示不加入定时任务
STATIC_PAGES_REFRESH_INTERVAL=300
# 连续保存时合并重建请求的防抖窗口（秒）
STATIC_PAGES_DEBOUNCE_SECONDS=15
# 每个分类/排序最多生成的页数，超出部分自动回退动态页
STATIC_PAGES_MAX_LIST_PAGES=500
# 单次构建允许生成的总页数上限
STATIC_PAGES_MAX_TOTAL_PAGES=2000
# 构建锁有效期（秒），避免定时任务与数据变更任务并发发布
STATIC_PAGES_BUILD_LOCK_SECONDS=600

CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# 激活链接使用的站点地址（部署时改成实际域名）与有效期（秒）
SITE_URL=http://127.0.0.1:8000
USER_ACTIVATION_TIMEOUT=86400

# 支付：mock 为本地模拟收银台；切换 alipay 需要安装 python-alipay-sdk
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_SECRET=change-me-payment-mock-secret

# 支付宝（PAYMENT_PROVIDER=alipay 时填写；私钥/公钥里的换行写成 \n）
PAYMENT_ALIPAY_APP_ID=
PAYMENT_ALIPAY_SELLER_ID=
PAYMENT_ALIPAY_PRIVATE_KEY=
PAYMENT_ALIPAY_PUBLIC_KEY=
# 沙盒：PAYMENT_ALIPAY_DEBUG=1 且网关留空，会自动使用支付宝沙盒网关
# 生产：PAYMENT_ALIPAY_DEBUG=0 且网关留空，会自动使用正式网关
PAYMENT_ALIPAY_GATEWAY=
# 支付方式：page = 电脑网站支付(alipay.trade.page.pay)，wap = 手机网站支付(alipay.trade.wap.pay)
PAYMENT_ALIPAY_PAY_METHOD=page
PAYMENT_ALIPAY_NOTIFY_URL=http://127.0.0.1:8000/order/pay/notify/alipay/
PAYMENT_ALIPAY_RETURN_URL=http://127.0.0.1:8000/order/pay/return/alipay/
PAYMENT_ALIPAY_DEBUG=0

# 未支付订单主动查询：创建后多久开始查、最多追溯几天、状态页查询节流（秒）
PAYMENT_QUERY_AFTER_SECONDS=300
PAYMENT_QUERY_MAX_AGE_DAYS=2
PAYMENT_QUERY_THROTTLE_SECONDS=5
PAYMENT_STATUS_POLL_INTERVAL=2

# 未支付订单超时关闭：30 分钟后取消，每 60 秒扫描一次，每批 100 单
ORDER_UNPAID_TIMEOUT_SECONDS=1800
ORDER_CANCEL_CHECK_INTERVAL=60
ORDER_CANCEL_BATCH_SIZE=100
# 订单评论提交开关：0 表示紧急关闭写入口，已审核评论仍展示
ORDER_COMMENT_ENABLED=1

# 促销算价：标准运费、总开关与邀请活动开关。
# 邀请好友活动已下线，邀请框架仅保留用于历史数据审计，默认关闭。
STANDARD_TRANSIT_PRICE=10.00
PROMOTION_PRICING_ENABLED=1
PROMOTION_COUPON_ENABLED=1
PROMOTION_REFERRAL_ENABLED=0
REFERRAL_CODE_MAX_AGE=15552000

MAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=天天生鲜 <noreply@ecommerce.local>

# 真实发信时改用 SMTP 后端并填写以下配置（TLS 与 SSL 只启用一种）
# MAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.qq.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-account@qq.com
# EMAIL_HOST_PASSWORD=your-smtp-auth-code
# EMAIL_USE_TLS=1
# EMAIL_USE_SSL=0
# EMAIL_TIMEOUT=10

# 开发期本地存储；FastDFS 部署完成后改为 utils.storage.FastDFSStorage
STORAGE_BACKEND=django.core.files.storage.FileSystemStorage

# FastDFS：启动 docker compose 后，把 STORAGE_BACKEND 改为 utils.storage.FastDFSStorage
FDFS_TRACKER_SERVER=127.0.0.1:22122
FDFS_URL=http://127.0.0.1:8888/
FDFS_UPLOAD_URL=http://127.0.0.1:8888/api/upload
FDFS_DELETE_URL=http://127.0.0.1:8888/api/delete
FDFS_UPLOAD_TOKEN=change-me-fastdfs-upload-token
FDFS_TIMEOUT=15
FDFS_MAX_UPLOAD_BYTES=104857600

TRUST_X_FORWARDED_PROTO=0

CSRF_TRUSTED_ORIGINS=
